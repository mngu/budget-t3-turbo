{
  "name": "@budget/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "categorize": "pnpm with-env tsx scripts/categorize.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "import": "pnpm with-env tsx scripts/import.ts && pnpm with-env tsx scripts/categorize.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "sync": "pnpm with-env tsx scripts/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@budget/auth": "workspace:*",
    "@budget/db": "workspace:*",
    "@budget/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@budget/eslint-config": "workspace:*",
    "@budget/prettier-config": "workspace:*",
    "@budget/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "prettier": "@budget/prettier-config"
}
