# Le contexte d'image est `deploy/` (voir deploy/deploy.sh), pas la racine —
# ce fichier est un filet pour un `docker build` lancé d'ici par erreur.
# `data/` contient les credentials Enable Banking, `.env` la clé Anthropic et
# AUTH_SECRET : ni l'un ni l'autre ne doit entrer dans une couche d'image.
.env
.env.*
!.env.example
data/
node_modules/
.git/
.turbo/
**/.turbo/
**/node_modules/
