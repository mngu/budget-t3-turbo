{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /** Base Options */
    "esModuleInterop": true,
    "skipLibCheck": true,
    /**
     * ES2024 et non ESNext : tout est `noEmit` (ou `emitDeclarationOnly`), ces
     * deux options ne décrivent donc que les globales que TS croit disponibles —
     * c'est Vite/esbuild qui transpile. ESNext les ferait bouger à chaque
     * version de TypeScript, faisant passer pour disponible une proposition que
     * Node 22 n'a pas encore.
     */
    "target": "ES2024",
    "lib": ["ES2024"],
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /** Keep TSC performant in monorepos */
    "incremental": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",

    /** Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    /** Transpile using Bundler (not tsc) */
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "exclude": ["node_modules", "build", "dist", ".next", ".expo"]
}
