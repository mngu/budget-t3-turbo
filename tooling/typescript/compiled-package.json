{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /** Emit types for internal packages to speed up editor performance. */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    /**
     * TS 7 (TS5011) : le `rootDir` déduit n'est plus toléré à l'émission. Les
     * trois packages compilés ont tous leurs sources sous `src/`.
     */
    "rootDir": "${configDir}/src"
  }
}
