{
  "name": "create-t3-turbo",
  "private": true,
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "pnpm -F @budget/auth generate",
    "db:generate": "turbo -F @budget/db generate",
    "db:migrate": "turbo -F @budget/db migrate",
    "db:studio": "turbo -F @budget/db studio",
    "dev": "turbo watch dev --continue",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "knip": "knip"
  },
  "devDependencies": {
    "@turbo/gen": "^2.5.8",
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "eslint-plugin-turbo": "^2.5.8",
    "knip": "^6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.5.8",
    "typescript": "catalog:"
  }
}
