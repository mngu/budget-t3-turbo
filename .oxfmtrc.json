{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "packages/db/drizzle/meta/**",
    ".claude/skills/**",
    "apps/expo/uniwind-types.d.ts"
  ],
  "sortImports": {
    "internalPattern": ["@budget/", "~/"],
    "groups": [
      "type",
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
