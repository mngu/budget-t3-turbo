# Local PostgreSQL (docker compose up -d): use budget_t3, never budget.
POSTGRES_URL=postgres://budget:budget@localhost:5436/budget_t3

# Better Auth (openssl rand -base64 32)
AUTH_SECRET=

# LLM transaction categorization.
ANTHROPIC_API_KEY=

# Resend credentials for magic links and invitations.
# Without them, development logs links; production email delivery fails.
RESEND_API_KEY=
EMAIL_FROM=

# Public origin for auth and email links. Required on a VPS; defaults to localhost:3000 locally.
SITE_URL=

# SSH target for deploy/deploy.sh and deploy/pull-db.sh; keep the real host in untracked .env.
DEPLOY_HOST=root@<ip-du-vps>
